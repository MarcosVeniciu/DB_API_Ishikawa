# DB_API_Ishikawa Configuration
ENVIRONMENT=development
API_V1_STR=/v1

# Database Configuration (PostgreSQL 16 / Supabase)
DATABASE_URL=postgresql+psycopg://db_user:db_secret_pass@localhost:5433/db_ishikawa
# Para Supabase (Session Mode - porta 5432 para migrações e testes locais):
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# Para Supabase (Transaction Mode - porta 6543 para runtime da aplicação em produção):
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Inter-service Authentication (M2M)
SERVICE_TOKEN=local-dev-service-token-change-in-production

# Port
PORT=8001

# Seed de dados
SEED_ON_STARTUP=false
SEED_DATA_PATH=app/resources/test_data/farms.json

# Pool de conexões (Supavisor / PostgreSQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
