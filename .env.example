# DB_API_Ishikawa Configuration
ENVIRONMENT=development
API_V1_STR=/v1

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://db_user:db_secret_pass@localhost:5433/db_ishikawa

# Inter-service Authentication (M2M)
SERVICE_TOKEN=local-dev-service-token-change-in-production

# Port
PORT=8001
